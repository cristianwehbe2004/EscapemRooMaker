{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=escaperoom;Username=escaperoom;Password=escaperoom",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "escaperoom",
    "Audience": "escaperoom-clients",
    "Key": "replace-this-with-a-long-dev-key-at-least-32-characters"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ActionRateLimit": {
    "CooldownMs": 900,
    "PolicyName": "player-action-default",
    "Player": {
      "Enabled": true,
      "CooldownMs": 900,
      "PolicyName": "player-action-default"
    },
    "Gm": {
      "Enabled": false,
      "CooldownMs": 0,
      "PolicyName": "gm-action-bypass"
    }
  },
  "AllowedHosts": "*"
}
